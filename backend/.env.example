# ----------------------------------------------------------------------------
# PadosiPro backend environment.
# Copy to .env and fill in. Never commit .env — see CLAUDE.md.
#   local (no Supabase account):  docker compose up   (values below are supplied by compose)
#   local without Docker:         cp .env.example .env && npm run dev
# ----------------------------------------------------------------------------

# Runtime mode: development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# --- Database -----------------------------------------------------------------
# Plain PostgreSQL connection string, used by Prisma. No supabase-js.
#   Docker compose (from your host):  postgres://padosi:padosi@localhost:5432/padosipro
#   Supabase: Dashboard > Connect > Session pooler (port 5432). Use the pooler, not
#   db.<ref>.supabase.co — that host is IPv6-only and fails with ENOTFOUND on IPv4 networks.
#   The transaction pooler (6543) cannot run Prisma migrations.
DATABASE_URL=postgres://padosi:padosi@localhost:5432/padosipro

# TLS for the database connection: false for local Docker, true for Supabase.
DB_SSL=false

# Throwaway database for the integration tests. Unset, they skip and `npm test` runs unit tests only.
#   docker compose --profile test up -d db-test   (then migrate + seed against this URL)
TEST_DATABASE_URL=postgres://padosi:padosi@localhost:5433/padosipro_test

# TLS for the test database only. Defaults to false; DB_SSL above is ignored during tests so a
# Supabase setting cannot be applied to a plaintext local test server.
TEST_DB_SSL=false

# --- Auth ---------------------------------------------------------------------
# Signing key for our JWTs. Min 16 chars. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-in-production-please
# How long an access token stays valid (any ms/vercel duration string, e.g. 15m, 7d).
JWT_EXPIRES_IN=7d
# Extra server-side secret mixed into the OTP hash, so a leaked table is not brute-forceable.
# Min 16 chars. Generate with: openssl rand -base64 32
OTP_PEPPER=change-me-in-production-too

# --- Email (OTP delivery) -----------------------------------------------------
# console = print the OTP to the server log (default, needs no account)
# emailjs = send real mail; the four EMAILJS_* values below then become required
MAIL_DRIVER=console

# Get all four from https://dashboard.emailjs.com
# Email Services > your service ID (e.g. service_ab12cde)
EMAILJS_SERVICE_ID=
# Email Templates > the OTP template's ID (e.g. template_xy34zab)
EMAILJS_TEMPLATE_ID=
# Account > General > Public Key
EMAILJS_PUBLIC_KEY=
# Account > Security > Private Key. Required for REST API calls from a server.
EMAILJS_PRIVATE_KEY=
