# ----------------------------------------------------------------------------
# PadosiPro backend environment.
# Copy to .env and fill in. Never commit .env — see CLAUDE.md.
#   local (no Supabase account):  docker compose up   (defaults below are used)
#   local without Docker:         cp .env.example .env && npm run dev
# ----------------------------------------------------------------------------

# Runtime mode: development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=4000

# Plain PostgreSQL connection string. No supabase-js — we use Postgres directly.
#   Docker compose (from your host):  postgres://padosi:padosi@localhost:5432/padosipro
#   Supabase: Dashboard > Project Settings > Database > Connection string > URI
DATABASE_URL=postgres://padosi:padosi@localhost:5432/padosipro

# --- EmailJS (OTP delivery, called server-side only) -------------------------
# Get all four from https://dashboard.emailjs.com
# Email Services > your service ID (e.g. service_ab12cde)
EMAILJS_SERVICE_ID=
# Email Templates > the OTP template's ID (e.g. template_xy34zab)
EMAILJS_TEMPLATE_ID=
# Account > General > Public Key
EMAILJS_PUBLIC_KEY=
# Account > Security > Private Key. Required for REST API calls from a server.
EMAILJS_PRIVATE_KEY=
